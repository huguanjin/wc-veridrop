# Copy to .env on the Docker node and fill in your values.

# Web app security.
VERIDROP_SESSION_SECRET=replace-with-a-long-random-secret
VERIDROP_ADMIN_USERNAME=admin
VERIDROP_ADMIN_PASSWORD=replace-with-a-strong-password
VERIDROP_REQUIRE_LOGIN=1

# MongoDB on 10.0.2.236:27017, without authentication.
VERIDROP_MONGODB_URI=mongodb://10.0.2.236:27017/
VERIDROP_MONGODB_DATABASE=WcVeridrop

# Upstream model settings.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7
